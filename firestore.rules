rules_version = '2';

/* ============================================================
   NOTES SATHI — Firestore security rules  (v2)
   Paste into: Firebase Console -> Firestore Database -> Rules
   -> Publish.

   BEFORE publishing, replace ADMIN_UID (one place, in isAdmin()
   below) with your own UID: Console -> Authentication -> Users ->
   your account's UID. Do this AFTER creating your admin account
   (see ACCOUNTS-GO-LIVE-GUIDE.md, Part D).

   What these rules enforce (server-side — tamper-proof):
   1. A student can CREATE their profile exactly once, with
      status "pending" — nobody can self-approve.
   2. Only the ADMIN (you) can approve / reject / edit / delete.
   3. Only APPROVED students can write reactions, and only their
      own — pending or rejected accounts are blocked even if
      someone tampers with the app code.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- users ----------------
       doc: users/{uid} = { name, email, phone, status, createdAt }
       status: pending (new) -> approved / rejected (set by admin) */
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.phone.size() <= 16;

      allow update, delete: if isAdmin();
    }

    /* ---------------- reactions ----------------
       doc id: {uid}_{noteKey}
       fields: noteId, uid, name, read (bool), love (bool), updatedAt
       - readable by any signed-in student (the "who read" list)
       - writable ONLY by the owner AND only when APPROVED
       - owner can delete their own reaction (un-react)          */
    match /reactions/{docId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && isApproved()
                    && request.resource.data.uid is string
                    && request.resource.data.noteId is string
                    && request.resource.data.noteId.size() <= 90
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 40
                    && (!('read' in request.resource.data)
                        || request.resource.data.read is bool)
                    && (!('love' in request.resource.data)
                        || request.resource.data.love is bool);

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;
    }

    /* ---------------- helpers ---------------- */
    function isAdmin(){
      return request.auth != null && request.auth.uid == "ADMIN_UID";
    }
    function isApproved(){
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved";
    }
  }
}
